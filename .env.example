# Server
PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# APIs
VAPI_API_KEY=vapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here_min_32_chars
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# VAPI provisioning mode lors de l'onboarding restaurant.
#   pool    → cherche un numéro déjà acheté et libre dans le compte VAPI (défaut)
#   dynamic → achat à la volée via POST /phone-number (NON IMPLÉMENTÉ — placeholder)
VAPI_PROVISIONING_MODE=pool

# Google OAuth
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://api.tablenow.io/api/calendar/callback

# Google Places (New API)
GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Pinecone
PINECONE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=tablenow-knowledge

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=info@tablenow.io
EMAIL_DOMAIN=tablenow.io
BCC_SECRET=your_bcc_secret_here_min_32_chars

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
# Protège le endpoint POST /dashboard/insights/refresh (appelé par pg_cron)
INTERNAL_SECRET=your-internal-cron-secret-min-32-chars-here

# URLs
FRONTEND_URL=https://app.tablenow.io
BACKEND_URL=https://api.tablenow.io

