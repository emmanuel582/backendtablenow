# Server
PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# APIs
VAPI_API_KEY=vapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# VAPI provisioning mode lors de l'onboarding restaurant.
#   pool    → cherche un numéro déjà acheté et libre dans le compte VAPI (défaut)
#   dynamic → achat à la volée via POST /phone-number (NON IMPLÉMENTÉ — placeholder)
# Si "pool" et que tous les numéros sont assignés, l'onboarding échoue avec
# un log structuré "VAPI pool exhausted" — il faut alors acheter de nouveaux
# numéros dans le compte VAPI ou implémenter le mode dynamic.
VAPI_PROVISIONING_MODE=pool

# Google OAuth
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/callback

# Pinecone
PINECONE_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=tablenow-knowledge

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=info@tablenow.io
EMAIL_DOMAIN=tablenow.io

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# URLs
FRONTEND_URL=https://your-frontend-url.com  # Replace with your actual frontend URL
BACKEND_URL=https://backendtablenow.onrender.com
